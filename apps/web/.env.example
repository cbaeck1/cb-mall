# 8.65절: 서브도메인 통일 — 운영은 app./api. 실제 서비스 도메인, 로컬은 아래 값 사용
NEXT_PUBLIC_API_ORIGIN="http://localhost:4000"
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 서버 전용(NEXT_PUBLIC_ 접두어 없음 — 브라우저에 노출되지 않는다)
SSR_RELAY_SHARED_SECRET="change-me-server-to-server-secret"     # 8.53절, 백엔드와 동일 값
CACHE_REVALIDATE_SHARED_SECRET="change-me-revalidate-secret"    # 8.51절 C-6, 백엔드와 동일 값
