# ── DB (PRD 8.15/8.67/8.70절) ──
# 런타임: Supavisor 트랜잭션 모드 풀러(6543) + pgbouncer=true 필수(8.67절 P-1), connection_limit 지정 금지(P-3)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# 마이그레이션 전용: 세션 모드 풀러(8.70절 S-1) — :6543이나 pgbouncer=true 포함 금지
DIRECT_DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

NODE_ENV="development"
PORT="4000"

# ── 인증 (8.7/8.53절) ──
JWT_ACCESS_SECRET="change-me-min-32-chars-xxxxxxxxxxxxxxxx"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"
SSR_RELAY_SHARED_SECRET="change-me-server-to-server-secret"      # 8.53절: Next.js 서버 전용
CACHE_REVALIDATE_SHARED_SECRET="change-me-revalidate-secret"     # 8.51절 C-6

# ── AWS (8.4/8.10절) ──
AWS_REGION="ap-northeast-2"
S3_PRIVATE_BUCKET="cbmall-private-ebooks"
S3_PUBLIC_BUCKET="cbmall-public-assets"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
KMS_KEY_ID=""

# ── 토스페이먼츠 (8.8절) ──
TOSS_SECRET_KEY="test_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── 알림 (8.13/8.14/8.16절) ──
RESEND_API_KEY=""
MAIL_FROM="cb몰 <no-reply@mail.cbmall.example>"
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_SENDER_NUMBER=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ── CORS/도메인 (8.51절 C-5, 8.65절) ──
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://app.cbmall.example"

# ── 관측 (8.24/8.42절) ──
SENTRY_DSN=""
LOG_LEVEL="info"

# ── 부트스트랩(8.20절) ──
SEED_SUPER_ADMIN_EMAIL="admin@cbmall.example"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!seed"
REFRESH_COOKIE_DOMAIN=""
FRONTEND_ORIGIN="http://localhost:3000"
